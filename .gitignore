docs/doxygen/

**/*.nc

# Pinned GEOSmie MIE snapshot must be version-controlled so baked-in table generation
# is hermetic and reproducible offline (research R1, FR-016, SC-007). Negate the global
# NetCDF ignore for exactly these inputs.
!tools/geosmie_snapshot/*.nc
# Generated baked-in header is committed as the reproducibility artifact (T039 CI diff gate).
!src/src_impl/data/generated/MieTableData.hpp
